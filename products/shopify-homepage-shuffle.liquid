<style>
.kfx{background:#0B0E11;color:#F2EDE4;font-family:system-ui,-apple-system,sans-serif}
.kfx a{color:inherit}
.kfx .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.kfx section{padding:80px 0}

/* HERO */
.kfx-hero{position:relative;min-height:90vh;display:flex;align-items:flex-end;overflow:hidden;padding:0}
.kfx-hero .bg{position:absolute;inset:0;background:radial-gradient(120% 90% at 78% 110%,rgba(255,107,44,.28),transparent 55%),radial-gradient(90% 70% at 15% 100%,rgba(255,179,92,.12),transparent 60%),linear-gradient(180deg,#0B0E11 0%,#10141a 55%,#171310 100%);animation:kfheat 9s ease-in-out infinite alternate}
@keyframes kfheat{from{filter:brightness(1)}to{filter:brightness(1.18) saturate(1.25)}}
.kfx-hero .bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,14,17,.7),rgba(11,14,17,.2) 45%,rgba(11,14,17,.9))}
.kfx-hero .in{position:relative;z-index:2;width:100%;padding:120px 24px 80px;max-width:1180px;margin:0 auto}
.kfx-hero .eyebrow{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#FF6B2C;margin:0 0 14px}
.kfx-hero h1{font-size:clamp(38px,6.5vw,80px);line-height:1;letter-spacing:-.025em;font-weight:800;max-width:12ch;margin:0;color:#F2EDE4}
.kfx-hero h1 span{background:linear-gradient(92deg,#FF6B2C 10%,#FFB35C 60%,#ffe0b0 95%);-webkit-background-clip:text;background-clip:text;color:transparent}
.kfx-hero .sub{margin-top:20px;font-family:ui-monospace,monospace;font-size:14px;color:#8B98A5}
.kfx-hero .sub b{color:#F2EDE4}
.kfx-btn{display:inline-block;margin-top:30px;padding:16px 28px;font-weight:700;font-size:15px;background:#FF6B2C;color:#160a04;text-decoration:none;border-radius:2px}

/* EYEBROW/HEADING SHARED */
.kfx-eb{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#FF6B2C;margin:0}
.kfx h2{font-size:clamp(26px,3.6vw,40px);line-height:1.1;letter-spacing:-.02em;font-weight:750;margin:14px 0 10px;color:#F2EDE4}
.kfx .subtext{color:#8B98A5;max-width:56ch;margin:0}

/* GUIDE GRID */
.kfx-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
@media(max-width:900px){.kfx-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.kfx-grid{grid-template-columns:1fr}}
/* only the first 6 cards in DOM order are ever visible — the shuffle script
   reorders the cards, which is what changes who those 6 are */
.kfx-grid .kfx-card:nth-child(n+7){display:none}
.kfx-card{background:#13181E;border:1px solid rgba(242,237,228,.08);border-radius:4px;overflow:hidden;text-decoration:none;color:inherit;display:block}
.kfx-card img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.kfx-card .body{padding:18px}
.kfx-card h3{font-size:16px;font-weight:650;margin:0 0 10px;color:#F2EDE4}
.kfx-pnl{font-family:ui-monospace,monospace;font-size:12px;display:flex;justify-content:space-between;border-top:1px dashed rgba(242,237,228,.12);padding-top:10px;color:#8B98A5}
.kfx-pnl b{color:#4ED9A4}
.kfx-cost{font-family:ui-monospace,monospace;font-size:12px;color:#8B98A5;margin-top:6px}
.kfx-cost b{color:#FFB35C}
.kfx-foot{display:flex;justify-content:space-between;margin-top:12px;font-family:ui-monospace,monospace;font-size:14px}
.kfx-go{color:#FF6B2C;font-size:12.5px;font-weight:600}
.kfx-reshuffle{margin-top:26px;display:inline-flex;align-items:center;gap:8px;background:none;border:1px solid rgba(242,237,228,.18);color:#F2EDE4;font-family:ui-monospace,monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:11px 18px;border-radius:2px;cursor:pointer}
.kfx-reshuffle:hover{border-color:#FF6B2C;color:#FF6B2C}
.kfx-reshuffle[hidden]{display:none}

/* ESCAPE TIMELINE */
.kfx-tl{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:40px}
@media(max-width:860px){.kfx-tl{grid-template-columns:1fr}}
.kfx-tl>div{border-top:1px solid rgba(242,237,228,.12);position:relative;padding:18px 26px 8px 0}
@media(max-width:860px){.kfx-tl>div{border-top:none;border-left:1px solid rgba(242,237,228,.12);padding:0 0 30px 22px}}
.kfx-tl>div::before{content:"";position:absolute;top:-4px;left:0;width:7px;height:7px;border-radius:50%;background:#FF6B2C}
@media(max-width:860px){.kfx-tl>div::before{top:0;left:-4px}}
.kfx-tl .m{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#FFB35C}
.kfx-tl h4{font-size:15.5px;font-weight:650;margin:10px 0 6px;color:#F2EDE4}
.kfx-tl p{font-size:13px;color:#8B98A5;line-height:1.6;margin:0}
.kfx-founder{margin-top:50px;background:#13181E;border:1px solid rgba(242,237,228,.08);border-left:2px solid #FF6B2C;border-radius:4px;padding:28px}
.kfx-founder p{margin:0;font-size:16px;line-height:1.55;color:#e8e2d6}
.kfx-founder cite{display:block;margin-top:14px;font-style:normal;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8B98A5}

/* INSIDE GRID */
.kfx-inside{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(242,237,228,.08);border:1px solid rgba(242,237,228,.08);margin-top:40px}
@media(max-width:900px){.kfx-inside{grid-template-columns:repeat(2,1fr)}}
.kfx-inside>div{background:#0B0E11;padding:24px 20px}
.kfx-inside b{display:block;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;color:#FF6B2C;margin-bottom:8px}
.kfx-inside h4{font-size:15px;font-weight:650;margin:0 0 6px;color:#F2EDE4}
.kfx-inside p{font-size:13px;color:#8B98A5;margin:0}

/* MATH BAND */
.kfx-math{text-align:center;background:linear-gradient(120deg,#171310,#13181E 60%);border-top:1px solid rgba(242,237,228,.08);border-bottom:1px solid rgba(242,237,228,.08);padding:50px 20px}
.kfx-math .big{font-family:ui-monospace,monospace;font-size:clamp(24px,4.6vw,48px);font-weight:600;margin:14px 0 8px}
.kfx-math .big b{color:#4ED9A4}
.kfx-math .big s{color:#8B98A5;opacity:.5}
.kfx-math p{color:#8B98A5;font-size:14px;margin:0}
.kfx-math .cost-line{color:#FFB35C;display:block;margin-top:6px}

/* QUOTES */
.kfx-quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
@media(max-width:820px){.kfx-quotes{grid-template-columns:1fr}}
.kfx-quote{background:#13181E;border:1px solid rgba(242,237,228,.08);border-left:2px solid #FF6B2C;padding:22px 20px;border-radius:4px;font-size:14px;color:#d8d2c6}
.kfx-quote span{display:block;margin-top:14px;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8B98A5}

/* FINAL CTA */
.kfx-final{text-align:center;background:radial-gradient(70% 130% at 50% 140%,rgba(255,107,44,.3),transparent 60%);padding:70px 20px}
.kfx-final h2{max-width:16ch;margin:14px auto 10px}
.kfx-final p{color:#8B98A5;margin:0 auto;max-width:50ch}
</style>

<div class="kfx">

  <!-- HERO -->
  <section class="kfx-hero">
    <div class="bg"></div>
    <video autoplay muted loop playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1">
      <source src="https://cdn.shopify.com/videos/c/o/v/ce4a4b89170a4ab39bde18af14ac8269.mp4" type="video/mp4">
    </video>
    <div class="in" style="z-index:2">
      <p class="eyebrow">Built inside a $15 million hotel kitchen</p>
      <h1>Turn any cuisine into a <span>profitable restaurant.</span></h1>
      <p class="sub">$29.99 · 28 recipes · full P&amp;L model · <b>instant download</b></p>
      <a class="kfx-btn" href="/collections/all">Browse all {{ collections.all.products_count }} guides</a>
    </div>
  </section>

  <!-- GUIDE GRID — pool is built from the live catalogue, shuffled on every page load.
       The card numbers come from the KF STATS TABLE at the top of this file. -->
  <section>
    <div class="wrap">
      <p class="kfx-eb">A different six every time you visit</p>
      <h2>Every guide is a working restaurant, on paper.</h2>
      <p class="subtext">Not a course. A working file — recipes with food-cost %, the full P&amp;L, the floor plan, the scripts.</p>

      <div class="kfx-grid" id="kfx-guide-grid">
        {%- for product in collections.all.products limit: 50 -%}
          {%- unless kf_exclude contains product.handle or product.featured_image == blank -%}

            {%- assign kf_pl = '' -%}
            {%- assign kf_margin = '' -%}
            {%- assign kf_startup = '' -%}
            {%- assign kf_title = '' -%}
            {%- for row in kf_stats -%}
              {%- assign f = row | strip | split: '::' -%}
              {%- if f[0] == product.handle -%}
                {%- assign kf_pl = f[1] -%}
                {%- assign kf_margin = f[2] -%}
                {%- assign kf_startup = f[3] -%}
                {%- assign kf_title = f[4] -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if kf_title == blank -%}
              {%- assign kf_title = product.title | truncate: 46 -%}
            {%- endif -%}

            <a class="kfx-card" href="{{ product.url }}">
              <img src="{{ product.featured_image | image_url: width: 800 }}"
                   alt="{{ product.title | escape }}" loading="lazy" width="800" height="600">
              <div class="body">
                <h3>{{ kf_title }}</h3>
                {%- if kf_pl != blank and kf_margin != blank -%}
                  <div class="kfx-pnl"><span>P&amp;L <b>{{ kf_pl }}</b></span><span>Margin <b>{{ kf_margin }}</b></span></div>
                {%- else -%}
                  <div class="kfx-pnl"><span>Full P&amp;L model</span><span>Instant download</span></div>
                {%- endif -%}
                {%- if kf_startup != blank -%}
                  <div class="kfx-cost">Startup <b>{{ kf_startup }}</b></div>
                {%- endif -%}
                <div class="kfx-foot"><span>{{ product.price | money }}</span><span class="kfx-go">View guide →</span></div>
              </div>
            </a>

          {%- endunless -%}
        {%- endfor -%}
      </div>

      <button type="button" class="kfx-reshuffle" id="kfx-reshuffle" hidden>↻ Show me six more</button>
    </div>
  </section>

  <script>
  (function () {
    var grid = document.getElementById('kfx-guide-grid');
    if (!grid) return;

    function shuffle() {
      var cards = Array.prototype.slice.call(grid.children);
      if (cards.length < 2) return;
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = cards[i]; cards[i] = cards[j]; cards[j] = tmp;
      }
      // Re-append in the new order. Only the first 6 are shown (see CSS),
      // and the rest stay display:none so their images are never fetched.
      var frag = document.createDocumentFragment();
      cards.forEach(function (c) { frag.appendChild(c); });
      grid.appendChild(frag);
    }

    shuffle();

    // Only offer the reshuffle button when there is more than one screenful.
    var btn = document.getElementById('kfx-reshuffle');
    if (btn && grid.children.length > 6) {
      btn.hidden = false;
      btn.addEventListener('click', shuffle);
    }
  })();
  </script>

