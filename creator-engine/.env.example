# Copy to .env and fill in. Never commit .env.

# Where the app is reachable (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
# Random string, used to sign cookies. Any long random value.
SESSION_SECRET=change-me-to-a-long-random-string
# Option A (one store, simplest): custom-app Admin API token from your store admin
#   Settings → Apps and sales channels → Develop apps → Create app → Admin API scopes
#   read_products, read_orders, write_discounts → Install → reveal token (shpat_...)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Option B (OAuth, needed for connecting other brands' stores): Partner Dashboard app
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,write_discounts
SHOPIFY_API_VERSION=2026-10

# Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Apify (console.apify.com > Settings > Integrations > API token). Used for creator discovery.
APIFY_TOKEN=
# Which market the brand sells into by default: AU or US. Can be changed per store in the app.
DEFAULT_MARKET=AU
# Accounts: the first visit to /setup creates the owner. Brands self-register at /signup unless ALLOW_SIGNUP=false.
ALLOW_SIGNUP=true
# Owner account from env (created on boot; change OWNER_PASSWORD to change the password)
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional one-shot automation on boot, idempotent: webhook on, campaign, brief, programme open, test creator
# BOOTSTRAP_PROGRAMME={"name":"Guide affiliates","product":"omakase","kind":"affiliate","commission":40,"discount":10,"test_creator":"kf.test"}
# Pull recent orders for every store this often (minutes); the Shopify webhook handles real time. 0 disables.
AUTO_SYNC_MINUTES=60

# HeyGen (optional, only for AI hook tests; app.heygen.com > Settings > API)
HEYGEN_API_KEY=
# Optional: pin an avatar and voice. Leave blank to pick the first available on first render.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Brand voice used in every script. Short and specific.
BRAND_NAME=KitchenFounder
BRAND_VOICE=Direct, practical, no hype. Talks like an experienced chef to a first-time restaurant owner.
# The exact disclosure line that must appear in every video caption.
AI_DISCLOSURE=This video features an AI presenter.

# Where the SQLite database and rendered files live. On Railway, mount a volume here.
DATA_DIR=./data
