hen — Operations Guide\nperuvian-cevicheria-restaurant-operations-guide-28-recipes-full-p-l::$1.3M::35%::::Peruvian Cevicheria — Operations Guide\nsingaporean-hawker-centre-restaurant-operations-guide-28-recipes-full-p-l::$1.3M::34%::::Singaporean Hawker Centre\nspanish-tapas-bar-restaurant-operations-guide-28-recipes-full-p-l-1::$992K::40%::::Spanish Tapas Bar — Operations Guide\nsri-lankan-hoppers-restaurant-operations-guide-28-recipes-full-p-l::$1.1M::32%::::Sri Lankan Hoppers — Operations Guide\ntaiwanese-beef-noodle-restaurant-operations-guide-28-recipes-full-p-l::$1.0M::32%::::Taiwanese Beef Noodle — Operations Guide\nturkish-meze-restaurant-operations-guide-28-recipes-full-p-l::$1.2M::33%::::Turkish Meze — Operations Guide\nvietnamese-phở-restaurant-operations-guide-28-recipes-full-p-l::$1.2M::33%::::Vietnamese Phở — Operations Guide\nyemeni-mandi-restaurant-operations-guide-28-recipes-full-p-l::$1.2M::36%::::Yemeni Mandi — Operations Guide\n{%- endcapture -%}\n{%- assign kf_stats = kf_stats_raw | strip | split: '\n' -%}\n\n{%- comment -%} Products to keep out of the guide shuffle (free tools, bundles, etc.) {%- endcomment -%}\n{%- assign kf_exclude = 'free-food-cost-calculator,free-labour-planner' | split: ',' -%}\n\n<style>\n.kfx{background:#0B0E11;color:#F2EDE4;font-family:system-ui,-apple-system,sans-serif}\n.kfx a{color:inherit}\n.kfx .wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.kfx section{padding:80px 0}\n\n/* HERO */\n.kfx-hero{position:relative;min-height:90vh;display:flex;align-items:flex-end;overflow:hidden;padding:0}\n.kfx-hero .bg{position:absolute;inset:0;background:radial-gradient(120% 90% at 78% 110%,rgba(255,107,44,.28),transparent 55%),radial-gradient(90% 70% at 15% 100%,rgba(255,179,92,.12),transparent 60%),linear-gradient(180deg,#0B0E11 0%,#10141a 55%,#171310 100%);animation:kfheat 9s ease-in-out infinite alternate}\n@keyframes kfheat{from{filter:brightness(1)}to{filter:brightness(1.18) saturate(1.25)}}\n.kfx-hero .bg::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,14,17,.7),rgba(11,14,17,.2) 45%,rgba(11,14,17,.9))}\n.kfx-hero .in{position:relative;z-index:2;width:100%;padding:120px 24px 80px;max-width:1180px;margin:0 auto}\n.kfx-hero .eyebrow{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#FF6B2C;margin:0 0 14px}\n.kfx-hero h1{font-size:clamp(38px,6.5vw,80px);line-height:1;letter-spacing:-.025em;font-weight:800;max-width:12ch;margin:0;color:#F2EDE4}\n.kfx-hero h1 span{background:linear-gradient(92deg,#FF6B2C 10%,#FFB35C 60%,#ffe0b0 95%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.kfx-hero .sub{margin-top:20px;font-family:ui-monospace,monospace;font-size:14px;color:#8B98A5}\n.kfx-hero .sub b{color:#F2EDE4}\n.kfx-btn{display:inline-block;margin-top:30px;padding:16px 28px;font-weight:700;font-size:15px;background:#FF6B2C;color:#160a04;text-decoration:none;border-radius:2px}\n\n/* EYEBROW/HEADING SHARED */\n.kfx-eb{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#FF6B2C;margin:0}\n.kfx h2{font-size:clamp(26px,3.6vw,40px);line-height:1.1;letter-spacing:-.02em;font-weight:750;margin:14px 0 10px;color:#F2EDE4}\n.kfx .subtext{color:#8B98A5;max-width:56ch;margin:0}\n\n/* GUIDE GRID */\n.kfx-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}\n@media(max-width:900px){.kfx-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:600px){.kfx-grid{grid-template-columns:1fr}}\n/* only the first 6 cards in DOM order are ever visible — the shuffle script\n   reorders the cards, which is what changes who those 6 are */\n.kfx-grid .kfx-card:nth-child(n+7){display:none}\n.kfx-card{background:#13181E;border:1px solid rgba(242,237,228,.08);border-radius:4px;overflow:hidden;text-decoration:none;color:inherit;display:block}\n.kfx-card img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.kfx-card .body{padding:18px}\n.kfx-card h3{font-size:16px;font-weight:650;margin:0 0 10px;color:#F2EDE4}\n.kfx-pnl{font-family:ui-monospace,monospace;font-size:12px;display:flex;justify-content:space-between;border-top:1px dashed rgba(242,237,228,.12);padding-top:10px;color:#8B98A5}\n.kfx-pnl b{color:#4ED9A4}\n.kfx-cost{font-family:ui-monospace,monospace;font-size:12px;color:#8B98A5;margin-top:6px}\n.kfx-cost b{color:#FFB35C}\n.kfx-foot{display:flex;justify-content:space-between;margin-top:12px;font-family:ui-monospace,monospace;font-size:14px}\n.kfx-go{color:#FF6B2C;font-size:12.5px;font-weight:600}\n.kfx-reshuffle{margin-top:26px;display:inline-flex;align-items:center;gap:8px;background:none;border:1px solid rgba(242,237,228,.18);color:#F2EDE4;font-family:ui-monospace,monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:11px 18px;border-radius:2px;cursor:pointer}\n.kfx-reshuffle:hover{border-color:#FF6B2C;color:#FF6B2C}\n.kfx-reshuffle[hidden]{display:none}\n\n/* ESCAPE TIMELINE */\n.kfx-tl{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:40px}\n@media(max-width:860px){.kfx-tl{grid-template-columns:1fr}}\n.kfx-tl>div{border-top:1px solid rgba(242,237,228,.12);position:relative;padding:18px 26px 8px 0}\n@media(max-width:860px){.kfx-tl>div{border-top:none;border-left:1px solid rgba(242,237,228,.12);padding:0 0 30px 22px}}\n.kfx-tl>div::before{content:\"\";position:absolute;top:-4px;left:0;width:7px;height:7px;border-radius:50%;background:#FF6B2C}\n@media(max-width:860px){.kfx-tl>div::before{top:0;left:-4px}}\n.kfx-tl .m{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#FFB35C}\n.kfx-tl h4{font-size:15.5px;font-weight:650;margin:10px 0 6px;color:#F2EDE4}\n.kfx-tl p{font-size:13px;color:#8B98A5;line-height:1.6;margin:0}\n.kfx-founder{margin-top:50px;background:#13181E;border:1px solid rgba(242,237,228,.08);border-left:2px solid #FF6B2C;border-radius:4px;padding:28px}\n.kfx-founder p{margin:0;font-size:16px;line-height:1.55;color:#e8e2d6}\n.kfx-founder cite{display:block;margin-top:14px;font-style:normal;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8B98A5}\n\n/* INSIDE GRID */\n.kfx-inside{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(242,237,228,.08);border:1px solid rgba(242,237,228,.08);margin-top:40px}\n@media(max-width:900px){.kfx-inside{grid-template-columns:repeat(2,1fr)}}\n.kfx-inside>div{background:#0B0E11;padding:24px 20px}\n.kfx-inside b{display:block;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;color:#FF6B2C;margin-bottom:8px}\n.kfx-inside h4{font-size:15px;font-weight:650;margin:0 0 6px;color:#F2EDE4}\n.kfx-inside p{font-size:13px;color:#8B98A5;margin:0}\n\n/* MATH BAND */\n.kfx-math{text-align:center;background:linear-gradient(120deg,#171310,#13181E 60%);border-top:1px solid rgba(242,237,228,.08);border-bottom:1px solid rgba(242,237,228,.08);padding:50px 20px}\n.kfx-math .big{font-family:ui-monospace,monospace;font-size:clamp(24px,4.6vw,48px);font-weight:600;margin:14px 0 8px}\n.kfx-math .big b{color:#4ED9A4}\n.kfx-math .big s{color:#8B98A5;opacity:.5}\n.kfx-math p{color:#8B98A5;font-size:14px;margin:0}\n.kfx-math .cost-line{color:#FFB35C;display:block;margin-top:6px}\n\n/* QUOTES */\n.kfx-quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}\n@media(max-width:820px){.kfx-quotes{grid-template-columns:1fr}}\n.kfx-quote{background:#13181E;border:1px solid rgba(242,237,228,.08);border-left:2px solid #FF6B2C;padding:22px 20px;border-radius:4px;font-size:14px;color:#d8d2c6}\n.kfx-quote span{display:block;margin-top:14px;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8B98A5}\n\n/* FINAL CTA */\n.kfx-final{text-align:center;background:radial-gradient(70% 130% at 50% 140%,rgba(255,107,44,.3),transparent 60%);padding:70px 20px}\n.kfx-final h2{max-width:16ch;margin:14px auto 10px}\n.kfx-final p{color:#8B98A5;margin:0 auto;max-width:50ch}\n</style>\n\n<div class=\"kfx\">\n\n  <!-- HERO -->\n  <section class=\"kfx-hero\">\n    <div class=\"bg\"></div>\n    <video autoplay muted loop playsinline style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/ce4a4b89170a4ab39bde18af14ac8269.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"in\" style=\"z-index:2\">\n      <p class=\"eyebrow\">Built inside a $15 million hotel kitchen</p>\n      <h1>Turn any cuisine into a <span>profitable restaurant.</span></h1>\n      <p class=\"sub\">$29.99 · 28 recipes · full P&amp;L model · <b>instant download</b></p>\n      <a class=\"kfx-btn\" href=\"/collections/all\">Browse all {{ collections.all.products_count }} guides</a>\n    </div>\n  </section>\n\n  <!-- GUIDE GRID — pool is built from the live catalogue, shuffled on every page load.\n       The card numbers come from the KF STATS TABLE at the top of this file. -->\n  <section>\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">A different six every time you visit</p>\n      <h2>Every guide is a working restaurant, on paper.</h2>\n      <p class=\"subtext\">Not a course. A working file — recipes with food-cost %, the full P&amp;L, the floor plan, the scripts.</p>\n\n      <div class=\"kfx-grid\" id=\"kfx-guide-grid\">\n        {%- for product in collections.all.products limit: 50 -%}\n          {%- unless kf_exclude contains product.handle or product.featured_image == blank -%}\n\n            {%- assign kf_pl = '' -%}\n            {%- assign kf_margin = '' -%}\n            {%- assign kf_startup = '' -%}\n            {%- assign kf_title = '' -%}\n            {%- for row in kf_stats -%}\n              {%- assign f = row | strip | split: '::' -%}\n              {%- if f[0] == product.handle -%}\n                {%- assign kf_pl = f[1] -%}\n                {%- assign kf_margin = f[2] -%}\n                {%- assign kf_startup = f[3] -%}\n                {%- assign kf_title = f[4] -%}\n                {%- break -%}\n              {%- endif -%}\n            {%- endfor -%}\n            {%- if kf_title == blank -%}\n              {%- assign kf_title = product.title | truncate: 46 -%}\n            {%- endif -%}\n\n            <a class=\"kfx-card\" href=\"{{ product.url }}\">\n              <img src=\"{{ product.featured_image | image_url: width: 800 }}\"\n                   alt=\"{{ product.title | escape }}\" loading=\"lazy\" width=\"800\" height=\"600\">\n              <div class=\"body\">\n                <h3>{{ kf_title }}</h3>\n                {%- if kf_pl != blank and kf_margin != blank -%}\n                  <div class=\"kfx-pnl\"><span>P&amp;L <b>{{ kf_pl }}</b></span><span>Margin <b>{{ kf_margin }}</b></span></div>\n                {%- else -%}\n                  <div class=\"kfx-pnl\"><span>Full P&amp;L model</span><span>Instant download</span></div>\n                {%- endif -%}\n                {%- if kf_startup != blank -%}\n                  <div class=\"kfx-cost\">Startup <b>{{ kf_startup }}</b></div>\n                {%- endif -%}\n                <div class=\"kfx-foot\"><span>{{ product.price | money }}</span><span class=\"kfx-go\">View guide →</span></div>\n              </div>\n            </a>\n\n          {%- endunless -%}\n        {%- endfor -%}\n      </div>\n\n      <button type=\"button\" class=\"kfx-reshuffle\" id=\"kfx-reshuffle\" hidden>↻ Show me six more</button>\n    </div>\n  </section>\n\n  <script>\n  (function () {\n    var grid = document.getElementById('kfx-guide-grid');\n    if (!grid) return;\n\n    function shuffle() {\n      var cards = Array.prototype.slice.call(grid.children);\n      if (cards.length < 2) return;\n      for (var i = cards.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var tmp = cards[i]; cards[i] = cards[j]; cards[j] = tmp;\n      }\n      // Re-append in the new order. Only the first 6 are shown (see CSS),\n      // and the rest stay display:none so their images are never fetched.\n      var frag = document.createDocumentFragment();\n      cards.forEach(function (c) { frag.appendChild(c); });\n      grid.appendChild(frag);\n    }\n\n    shuffle();\n\n    // Only offer the reshuffle button when there is more than one screenful.\n    var btn = document.getElementById('kfx-reshuffle');\n    if (btn && grid.children.length > 6) {\n      btn.hidden = false;\n      btn.addEventListener('click', shuffle);\n    }\n  })();\n  </script>\n\n  <!-- SHOP BY SERIES — Asian / Dessert / Fire & Spice, all on the homepage -->\n  <section style=\"padding:0 0 20px\">\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">Shop by series</p>\n      <h2>Three ways in, all $29.99 a guide.</h2>\n    </div>\n    <div style=\"display:grid;grid-template-columns:1fr;gap:14px;margin-top:24px\">\n\n      <a href=\"/collections/asian-series\" style=\"position:relative;display:block;min-height:32vh;overflow:hidden;text-decoration:none\">\n        <video autoplay muted loop playsinline style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/d0c7133b4dbc4ea1aa1069444f21ff9a.mp4\" type=\"video/mp4\">\n        </video>\n        <div style=\"position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,14,17,.5) 0%,rgba(11,14,17,.35) 40%,rgba(11,14,17,.9) 100%)\"></div>\n        <div style=\"position:relative;z-index:2;padding:30px 24px;max-width:1180px;margin:0 auto\">\n          <p style=\"font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#FF6B2C;margin:0 0 8px\">Asian Series</p>\n          <h3 style=\"font-size:clamp(20px,3vw,30px);font-weight:800;color:#F2EDE4;margin:0 0 8px\">The most profitable Asian concepts in the US market.</h3>\n          <span style=\"display:inline-block;padding:11px 20px;background:#FF6B2C;color:#160a04;font-weight:700;font-size:13px;border-radius:4px\">Shop the Asian Series →</span>\n        </div>\n      </a>\n\n      <a href=\"/collections/dessert-series\" style=\"position:relative;display:block;min-height:32vh;overflow:hidden;text-decoration:none\">\n        <video autoplay muted loop playsinline style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/1fd7f9301ec6469889f415690aaac480.mp4\" type=\"video/mp4\">\n        </video>\n        <div style=\"position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,14,17,.5) 0%,rgba(11,14,17,.35) 40%,rgba(11,14,17,.9) 100%)\"></div>\n        <div style=\"position:relative;z-index:2;padding:30px 24px;max-width:1180px;margin:0 auto\">\n          <p style=\"font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#FF6B2C;margin:0 0 8px\">Dessert Series</p>\n          <h3 style=\"font-size:clamp(20px,3vw,30px);font-weight:800;color:#F2EDE4;margin:0 0 8px\">Small footprint. High margin. The lowest-cost way in.</h3>\n          <span style=\"display:inline-block;padding:11px 20px;background:#FF6B2C;color:#160a04;font-weight:700;font-size:13px;border-radius:4px\">Shop the Dessert Series →</span>\n        </div>\n      </a>\n\n      <a href=\"/collections/fire-and-spice-bundle\" style=\"position:relative;display:block;min-height:32vh;overflow:hidden;text-decoration:none\">\n        <video autoplay muted loop playsinline style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/c5081393088a426f987604b6ac2b71b8.mp4\" type=\"video/mp4\">\n        </video>\n        <div style=\"position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,14,17,.5) 0%,rgba(11,14,17,.35) 40%,rgba(11,14,17,.9) 100%)\"></div>\n        <div style=\"position:relative;z-index:2;padding:30px 24px;max-width:1180px;margin:0 auto\">\n          <p style=\"font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#FF6B2C;margin:0 0 8px\">Fire &amp; Spice Bundle</p>\n          <h3 style=\"font-size:clamp(20px,3vw,30px);font-weight:800;color:#F2EDE4;margin:0 0 8px\">Argentine Asado · Brazilian Churrasco · Mexican Taqueria</h3>\n          <span style=\"display:inline-block;padding:11px 20px;background:#FF6B2C;color:#160a04;font-weight:700;font-size:13px;border-radius:4px\">Shop Fire &amp; Spice →</span>\n        </div>\n      </a>\n\n    </div>\n  </section>\n\n  <!-- FREE TOOLS — email capture via $0 checkout, downloadable, offline-capable -->\n  <section style=\"padding-top:20px\">\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">Free downloads</p>\n      <h2>Two tools, free forever. Yours to keep — even offline.</h2>\n      <p class=\"subtext\">Same math behind every guide, as a desktop tool you download once and use anytime, no internet required.</p>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px\">\n        <a href=\"/products/free-food-cost-calculator\" style=\"background:#13181E;border:1px solid rgba(242,237,228,.08);border-radius:6px;padding:26px;text-decoration:none;display:block\">\n          <p style=\"font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#4ED9A4;margin:0 0 10px\">Free · Instant download</p>\n          <h3 style=\"font-size:19px;font-weight:700;color:#F2EDE4;margin:0 0 8px\">Food Cost Calculator</h3>\n          <p style=\"font-size:13.5px;color:#8B98A5;margin:0 0 16px\">Type ingredient costs, see your margin instantly. Works offline once downloaded.</p>\n          <span style=\"color:#FF6B2C;font-weight:700;font-size:13.5px\">Get it free →</span>\n        </a>\n        <a href=\"/products/free-labour-planner\" style=\"background:#13181E;border:1px solid rgba(242,237,228,.08);border-radius:6px;padding:26px;text-decoration:none;display:block\">\n          <p style=\"font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#4ED9A4;margin:0 0 10px\">Free · Instant download</p>\n          <h3 style=\"font-size:19px;font-weight:700;color:#F2EDE4;margin:0 0 8px\">Labour &amp; Rostering Planner</h3>\n          <p style=\"font-size:13.5px;color:#8B98A5;margin:0 0 16px\">Build a roster, see your true labour cost. Works offline once downloaded.</p>\n          <span style=\"color:#FF6B2C;font-weight:700;font-size:13.5px\">Get it free →</span>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- ESCAPE PLAN -->\n  <section>\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">Keep your paycheck</p>\n      <h2>You don't quit first. You quit last.</h2>\n      <p class=\"subtext\">The guide is built to run alongside your day job. Here's the timeline our operators actually follow.</p>\n      <div class=\"kfx-tl\">\n        <div><span class=\"m\">Months 1–3</span><h4>Learn the system</h4><p>Nights and weekends. Pick your concept, work through the guide, run the numbers on your market.</p></div>\n        <div><span class=\"m\">Months 3–5</span><h4>Secure the money &amp; site</h4><p>Your savings + the guide's P&amp;L become a bankable plan. Sign nothing until the model says yes.</p></div>\n        <div><span class=\"m\">Months 5–7</span><h4>Build &amp; hire</h4><p>Fit-out runs while you still earn. The staffing model and floor scripts train a crew for you.</p></div>\n        <div><span class=\"m\" style=\"color:#FF6B2C\">Month 8</span><h4 style=\"color:#FF6B2C\">Hand in your resignation</h4><p>The week before opening night — not a day earlier.</p></div>\n      </div>\n      <div class=\"kfx-founder\">\n        <p>\"I built all of these guides on my days off, while running a $15 million hotel kitchen full-time. Nights, weekends, one system at a time. If I could build the guides next to a day job, you can open your restaurant next to yours.\"</p>\n        <cite>Timothy · Head Chef, founder of KitchenFounder</cite>\n      </div>\n    </div>\n  </section>\n\n  <!-- WHAT'S INSIDE -->\n  <section>\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">Inside every guide</p>\n      <h2>Eight systems. One file.</h2>\n      <div class=\"kfx-inside\">\n        <div><b>01 — MENU</b><h4>28 costed recipes</h4><p>Every dish with food-cost % and target sell price.</p></div>\n        <div><b>02 — MONEY</b><h4>Full P&amp;L model</h4><p>Revenue, COGS, labour, rent — real US-market numbers.</p></div>\n        <div><b>03 — SPACE</b><h4>Floor plan</h4><p>Layout built for covers-per-service, not looks.</p></div>\n        <div><b>04 — SERVICE</b><h4>Floor scripts</h4><p>Word-for-word scripts your staff can run day one.</p></div>\n        <div><b>05 — RETENTION</b><h4>SMS templates</h4><p>The messages that bring a first-timer back a second time.</p></div>\n        <div><b>06 — SOURCING</b><h4>Supplier framework</h4><p>What to buy, spec sheets, and how to negotiate it.</p></div>\n        <div><b>07 — PEOPLE</b><h4>Staffing model</h4><p>Roster, roles, and labour % that protects your margin.</p></div>\n        <div><b>08 — LAUNCH</b><h4>Opening runbook</h4><p>The 90-day sequence from lease signing to first service.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- MATH -->\n  <section class=\"kfx-math\">\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">The math</p>\n      <div class=\"big\"><s>Consultant: $30,000</s> → <b>Guide: $29.99</b></div>\n      <p>A restaurant consultant charges $300/hour. This took 10 years to learn. You're getting it in 2 hours.\n        <span class=\"cost-line\">The cost of doing nothing is another year in the job.</span>\n      </p>\n    </div>\n  </section>\n\n  <!-- PROOF -->\n  <section>\n    <div class=\"wrap\">\n      <p class=\"kfx-eb\">From the pass</p>\n      <h2>Written by someone still on the line.</h2>\n      <div class=\"kfx-quotes\">\n        <div class=\"kfx-quote\">\"I was an accountant for 9 years. The opening runbook was the first plan that made quitting feel like math instead of a gamble.\"<span>Career switcher · ex-accountant, now café owner</span></div>\n        <div class=\"kfx-quote\">\"I've done 10 years in hotel F&amp;B. These are the numbers nobody shows you until you've already lost money learning them.\"<span>Timothy · Head Chef, author</span></div>\n        <div class=\"kfx-quote\">\"It reads like an operations manual, not a course. That's exactly why it works.\"<span>Café owner · Melbourne</span></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"kfx-final\" style=\"position:relative\">\n    <video autoplay muted loop playsinline style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;opacity:.4\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/136e12b159d6431ab3ebebf347818a5d.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"wrap\" style=\"position:relative;z-index:1\">\n      <p class=\"kfx-eb\">{{ collections.all.products_count }} cuisines · instant download</p>\n      <h2>Your restaurant already exists on paper.</h2>\n      <p>$29.99. Built by a chef who has run it. Written for the operator who hasn't — yet.</p>\n      <a class=\"kfx-btn\" href=\"/collections/all\">Browse all {{ collections.all.products_count }} guides — $29.99</a>\n    </div>\n  </section>\n\n</div>\n",
